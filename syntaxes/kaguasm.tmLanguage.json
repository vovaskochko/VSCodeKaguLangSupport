{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "KaguOS Assembler",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#write-command" },
		{ "include": "#copy-command" },
		{ "include": "#jump-commands" },
		{ "include": "#label-declaration" },
		{ "include": "#var-declaration" },
		{ "include": "#standalone-commands" }
	],
	"repository": {

		"comments": {
			"begin": "//",
			"end": "$",
			"name": "comment.line.double-slash.kaguasm"
		},

		"var-ref": {
			"match": "[@*]*var:\\w+",
			"name": "variable.other.kaguasm"
		},

		"label-ref": {
			"match": "\\*?label:\\w+",
			"name": "entity.name.function.kaguasm"
		},

		"register": {
			"match": "[@*]*(?:REG_\\w+|DISPLAY_\\w+|KEYBOARD_BUFFER|PROGRAM_COUNTER|SYS_ENERGY|FREE_\\w+|PROC_\\w+|SYS_\\w+|KERNEL_START)(?!\\w)",
			"name": "support.type.kaguasm"
		},

		"constant-value": {
			"patterns": [
				{
					"match": "\"(?:[^\"\\\\]|\\\\.)*\"",
					"name": "string.quoted.double.kaguasm"
				},
				{ "include": "#label-ref" },
				{
					"match": "(?:OP_|SYS_CALL_|COLOR_|KEYBOARD_READ_)\\w+",
					"name": "constant.numeric.kaguasm"
				},
				{
					"match": "-?\\d+(?:\\.\\d+)?",
					"name": "constant.numeric.kaguasm"
				}
			]
		},

		"address-operand": {
			"patterns": [
				{ "include": "#var-ref" },
				{ "include": "#register" },
				{
					"match": "-?\\d+",
					"name": "constant.numeric.kaguasm"
				}
			]
		},

		"write-command": {
			"begin": "^\\s*(write)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#comments" },
				{
					"match": "\\b(to)\\b",
					"name": "keyword.control.kaguasm"
				},
				{ "include": "#constant-value" },
				{ "include": "#address-operand" }
			]
		},

		"copy-command": {
			"begin": "^\\s*(copy)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#comments" },
				{
					"match": "\\b(to)\\b",
					"name": "keyword.control.kaguasm"
				},
				{ "include": "#address-operand" }
			]
		},

		"jump-commands": {
			"begin": "^\\s*(jump_if_not|jump_if|jump_err|jump)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#label-ref" },
				{ "include": "#var-ref" },
				{ "include": "#register" },
				{
					"match": "-?\\d+",
					"name": "constant.numeric.kaguasm"
				}
			]
		},

		"label-declaration": {
			"begin": "^\\s*(label)\\s+(\\w+)",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" },
				"2": { "name": "entity.name.function.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#comments" }
			]
		},

		"var-declaration": {
			"begin": "^\\s*(var)\\s+(\\w+)",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" },
				"2": { "name": "entity.name.function.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#comments" },
				{
					"match": "\"(?:[^\"\\\\]|\\\\.)*\"",
					"name": "string.quoted.double.kaguasm"
				},
				{
					"match": "-?\\d+(?:\\.\\d+)?",
					"name": "constant.numeric.kaguasm"
				}
			]
		},

		"standalone-commands": {
			"begin": "^\\s*(cpu_exec|DEBUG_ON|DEBUG_OFF)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#comments" }
			]
		}
	},
	"scopeName": "source.kga"
}
