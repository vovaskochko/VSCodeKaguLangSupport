{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "KaguOS Assembler",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#write-command" },
		{ "include": "#copy-command" },
		{ "include": "#jump-commands" },
		{ "include": "#label-declaration" },
		{ "include": "#var-declaration" },
		{ "include": "#standalone-commands" }
	],
	"repository": {
		"comments": {
			"begin": "//",
			"end": "$",
			"name": "comment.line.double-slash.kaguasm"
		},

		"var-reference": {
			"patterns": [
				{
					"match": "[@*]*var:\\w+",
					"name": "variable.other.kaguasm"
				}
			]
		},

		"register-or-address": {
			"patterns": [
				{ "include": "#var-reference" },
				{
					"match": ".+",
					"name": "support.variable.kaguasm"
				}
			]
		},

		"write-command": {
			"begin": "^\\s*(write)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{
					"match": "\\s+(\"(?:[^\"\\\\]|\\\\.)*\"|-?\\d+(?:\\.\\d+)?|OP_\\w+|SYS_CALL_\\w+|COLOR_\\w+|KEYBOARD_READ_\\w+|label:\\w+)\\s+(to)\\s+(\\*?(?:REG_\\w+|DISPLAY_\\w+|KEYBOARD_BUFFER|PROGRAM_COUNTER|SYS_ENERGY|FREE_\\w+|KERNEL_START|PROC_\\w+|SYS_\\w+|var:\\w+|-?\\d+))",
					"captures": {
						"1": {
							"patterns": [
								{
									"match": "\"(?:[^\"\\\\]|\\\\.)*\"",
									"name": "string.quoted.double.kaguasm"
								},
								{
									"match": "label:\\w+",
									"name": "entity.name.label.kaguasm"
								},
								{
									"match": ".+",
									"name": "constant.language.kaguasm"
								}
							]
						},
						"2": { "name": "keyword.control.kaguasm" },
						"3": {
							"patterns": [
								{ "include": "#var-reference" },
								{
									"match": ".+",
									"name": "support.variable.kaguasm"
								}
							]
						}
					}
				},
				{ "include": "#comments" }
			]
		},

		"copy-command": {
			"begin": "^\\s*(copy)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{
					"match": "\\s+([@*]*(?:REG_\\w+|DISPLAY_\\w+|KEYBOARD_BUFFER|PROGRAM_COUNTER|SYS_ENERGY|FREE_\\w+|KERNEL_START|PROC_\\w+|SYS_\\w+|var:\\w+|-?\\d+))\\s+(to)\\s+(\\*?(?:REG_\\w+|DISPLAY_\\w+|KEYBOARD_BUFFER|PROGRAM_COUNTER|SYS_ENERGY|FREE_\\w+|KERNEL_START|PROC_\\w+|SYS_\\w+|var:\\w+|-?\\d+))",
					"captures": {
						"1": {
							"patterns": [
								{ "include": "#var-reference" },
								{
									"match": ".+",
									"name": "support.variable.kaguasm"
								}
							]
						},
						"2": { "name": "keyword.control.kaguasm" },
						"3": {
							"patterns": [
								{ "include": "#var-reference" },
								{
									"match": ".+",
									"name": "support.variable.kaguasm"
								}
							]
						}
					}
				},
				{ "include": "#comments" }
			]
		},

		"jump-commands": {
			"begin": "^\\s*(jump_if_not|jump_if|jump_err|jump)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{
					"match": "\\s+(\\*?(?:label:\\w+|-?\\d+|var:\\w+|REG_\\w+|DISPLAY_\\w+|KEYBOARD_BUFFER|PROGRAM_COUNTER|SYS_ENERGY|FREE_\\w+|KERNEL_START|PROC_\\w+|SYS_\\w+))",
					"captures": {
						"1": {
							"patterns": [
								{
									"match": "\\*?label:\\w+",
									"name": "entity.name.label.kaguasm"
								},
								{ "include": "#var-reference" },
								{
									"match": ".+",
									"name": "support.variable.kaguasm"
								}
							]
						}
					}
				},
				{ "include": "#comments" }
			]
		},

		"label-declaration": {
			"begin": "^\\s*(label)\\s+(\\w+)",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" },
				"2": { "name": "entity.name.label.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#comments" }
			]
		},

		"var-declaration": {
			"begin": "^\\s*(var)\\s+(\\w+)",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" },
				"2": { "name": "entity.name.variable.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#comments" },
				{
					"match": "\"(?:[^\"\\\\]|\\\\.)*\"",
					"name": "string.quoted.double.kaguasm"
				},
				{
					"match": "-?\\d+(?:\\.\\d+)?",
					"name": "constant.numeric.kaguasm"
				}
			]
		},

		"standalone-commands": {
			"begin": "^\\s*(cpu_exec|DEBUG_ON|DEBUG_OFF)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.kaguasm" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#comments" }
			]
		}
	},
	"scopeName": "source.kga"
}
